# Rust
/target/
**/*.rs.bk
*.pdb

# Cargo
# Cargo.lock should be committed for binary projects (not libraries)
# See: https://doc.rust-lang.org/cargo/faq.html#why-do-binaries-have-cargolock-in-version-control-but-not-libraries

# Build artifacts
/debug/
/release/

# Data and logs
mysql_psql_data/
*.db
*.db-shm
*.db-wal
*.log
*.json
!example_stats_output.txt

# Environment variables
.env
.env.local
.env.*.local

# Docker
# .dockerignore should be tracked, so it's not listed here

